# Salin ke .env lalu isi nilainya. Jangan commit .env.
PORT=7002

# Mode testing. Selama nilainya BUKAN "false", pesan dikirim ke WA_PRIVATE_ID
# (nomor pribadi), bukan ke grup. Set TESTING=false hanya untuk produksi.
TESTING=true

# SQL Server (SCADA)
DB_SERVER=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=

# WABLAS
# URL lengkap endpoint kirim pesan (di-POST langsung oleh axios)
WABLAS_URL=
WABLAS_TOKEN=

# Penerima produksi (TESTING=false)
WA_GROUP_ID_TUAL=
WA_GROUP_ID_SOFIFI=

# Penerima saat TESTING=true (nomor pribadi, bukan grup)
WA_PRIVATE_ID=
